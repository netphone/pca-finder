@import "{ohif:design}/app"

.footer
    border-top 2px solid rgba(0, 0, 0, 0.5)
    padding 0px
    position relative
    bottom 0
    background-position initial !important
    background-size initial !important
    background-repeat initial !important
    background-attachment initial !important
    background-origin initial !important
    background-clip initial !important
    background-color rgb(37, 39, 46) !important
    padding-top 3rem!important
    z-index: 1030

.main_footer
    position relative

.footer-container
    padding-top 1rem
    padding-bottom 1rem

.footer-logo
    padding-bottom 2rem
    max-height 7rem
    width auto

@media screen and (min-width: 768px) and (max-width: 842px)
  .footer-logo
    max-height 6.5rem

footer
    &.main_footer
        padding 0 60px
        background #ffffff
        width 100%
        height 60px
        background-color #f5f5f5
        bottom 0px
        position absolute
        border-top 1px solid #ebebeb
        .main_footer_wrapper
            padding 10px 0 10px 0
            text-align center
            border-top 1px solid #ebebeb
        .copyright
            float left
            padding-bottom 3px
        .footer_socials
            float right
            padding 25px 0 1px 15px
            ul
                padding 0
                margin 0
                li
                    list-style none
                    display inline-block
                    margin 0 0 0 25px
                    padding 0
                    a
                        color #b0b0b0
                        font-size 13px

footer.main_footer .footer_socials ul li a:hover,
  footer.main_footer .copyright,
  footer.sidebar_footer .copyright
    color #1c2329

footer.sidebar_footer .footer_socials ul li a:hover,
  div.sidebar_footer .footer_socials ul li a:hover
    background #800000
