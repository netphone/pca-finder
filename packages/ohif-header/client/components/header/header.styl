@import "{ohif:design}/app"

body>.header
  min-height: $topBarHeight
  padding: 10px 10px 0
  theme('color', '$textPrimaryColor')
  theme('background-color', '#800000')
  transition(all 0.5s ease)

  &.navbar
    margin-bottom: 0px

    .navbar-nav
      _padding: 0 10px

  .navbar-brand
    padding: 0px 15px
    height: 68px

    &>.logo-image
      _max-height: 8rem

    @media screen and (min-width: 768px) and (max-width: 842px)
      &>.logo-image
        _max-height 6.5rem

  .navbar-form
    margin-top: 12px
  
  .navbar-toggle
    margin-top: 20px

  .navbar-collapse
    background-color: rgb(128, 0, 0)
    max-height: 380px

    &.navbar-collapse
      border-top: none
      -webkit-box-shadow: inset 0 1px 0 rgba(180, 0, 0, .1)
      box-shadow: inset 0 1px 0 rgba(180, 0, 0, .1)

  &>.clearfix
    position: relative

  .header-menu
    padding: 25px 0
    font-size: 16px
    font-weight: 400
    line-height: 21px
    text-decoration: none
    theme('color', '$defaultColor')    

    &:empty
      display: none

  .header-menu-default
    padding: 25px 0
    font-size: 16px
    font-weight: 400
    line-height: 21px
    text-decoration: none
    color: #fff !important

    &:empty
      display: none
    
    &:hover
      color: #9d9d9d !important

    &:focus
      color: #9d9d9d !important    

  &.header-big
    _height: $topBarExpandedHeight
    _background-color: rgba(21, 25, 30, 0.7)
    margin-bottom: 0px
    position: relative
